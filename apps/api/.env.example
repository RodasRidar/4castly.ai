SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=["http://localhost:5173"]

# Auth (S4): defaults come from SUPABASE_URL (issuer <url>/auth/v1, keys at <issuer>/.well-known/jwks.json).
# JWT_AUDIENCE=authenticated
# JWT_ISSUER=
# JWKS_URL=

# Storage and the worker. Needs `modal token` credentials (MODAL_TOKEN_ID / MODAL_TOKEN_SECRET) to spawn jobs.
STORAGE_BUCKET=uploads
MODAL_APP_NAME=castly-worker
MODAL_ENVIRONMENT=

# Database: Supabase pooler (transaction mode), connecting as the app_api role (no BYPASSRLS).
DATABASE_URL=
DB_POOL_SIZE=2

# Observability. Tokens only through the environment; datasets per environment (4castly-dev / 4castly-prod).
ENVIRONMENT=local
SERVICE_VERSION=0.1.0
AXIOM_DOMAIN=api.axiom.co
AXIOM_TOKEN=
AXIOM_DATASET=

# Only for `python -m api.provisioning` (an admin connection, never the app_api role).
PROVISION_DATABASE_URL=
