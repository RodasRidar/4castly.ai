# Local development against `supabase start` (cp .env.local.example .env.local). Overrides .env.
# Values for the keys below come from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=["http://localhost:5173"]

# After `supabase db reset`, give the API role a login once:
#   psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -c "alter role app_api login password 'dev'"
DATABASE_URL=postgresql+asyncpg://app_api:dev@127.0.0.1:54322/postgres
# Admin connection, only for scripts/seed_local.py and `python -m api.provisioning`.
PROVISION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Jobs: without Modal credentials the API cannot start the worker (the re-spawn sweep recovers them).
STORAGE_BUCKET=uploads
# The chat answers 503 without a key. Langfuse stays off when its keys are empty.
ANTHROPIC_API_KEY=

ENVIRONMENT=local
