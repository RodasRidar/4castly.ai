# Only to run worker functions by hand against a local database (cp .env.local.example .env.local).
# `make e2e-local` needs none of this: it starts its own database and runs the worker inline.
#   psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -c "alter role app_worker login password 'dev'"
DATABASE_URL=postgresql+psycopg://app_worker:dev@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ENVIRONMENT=local
